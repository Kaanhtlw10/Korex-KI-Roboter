#include <Arduino.h>
#include <Servo.h>
#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

#define SERVICE_UUID "FFE0"
#define CHARACTERISTIC_UUID "FFE1"

const int motorenVorne[] = {18, 19, 20, 21}; //vorne, vorne, hinten, hinten
const int motorenHinten[] = {37, 38, 39, 40}; //vorne, vorne, hinten, hinten
Servo servo;
int servoWinkel = 75;

const byte trigPins[] = {2, 4, 8, 10, 12};
const byte echoPins[] = {7, 5, 9, 11, 13};
const byte sensorCount = 5;  
const int ledPin = 8;
const int buzzerPin = 6;
bool buzzerAn = false;
uint32_t buzzerStartZeit = 0;
const uint16_t buzzerTonLaenge = 20;
uint32_t buzzerDelay = 0;

unsigned long letzteZeit = 0;
int intervall = 100;

BLECharacteristic *pCharacteristic;

void vorne() {
  for(int i = 0; i < 2; i++) {
    digitalWrite(motorenVorne[i], HIGH);
  }
  for(int i = 2; i < 4; i++) {
    digitalWrite(motorenVorne[i], LOW);
  }
  for(int i = 0; i < 2; i++) {
    digitalWrite(motorenHinten[i], HIGH);
  }
  for(int i = 2; i < 4; i++) {
    digitalWrite(motorenHinten[i], LOW);
  }
}                     

void hinten() {
  for(int i = 2; i < 4; i++) {
    digitalWrite(motorenVorne[i], HIGH);
  }
  for(int i = 0; i < 2; i++) {
    digitalWrite(motorenVorne[i], LOW);
  }
  for(int i = 2; i < 4; i++) {
    digitalWrite(motorenHinten[i], HIGH);
  }
  for(int i = 0; i < 2; i++) {
    digitalWrite(motorenHinten[i], LOW);
  }
}

void stopp() {
  for(int i = 0; i < 4; i++) {
    digitalWrite(motorenVorne[i], LOW);
  }
  for(int i = 0; i < 4; i++) {
    digitalWrite(motorenHinten[i], LOW);
  }
}

void neutral() { //Neutrale Servo-Position --> 75°
    servo.write(75);
    servoWinkel = 75;
}

void links() {
  unsigned long jetztigeZeit = millis();
  if(jetztigeZeit - letzteZeit >= intervall) {
    digitalWrite(motorenHinten[0], LOW);
    digitalWrite(motorenVorne[0], LOW);
    digitalWrite(motorenHinten[1], HIGH);
    digitalWrite(motorenVorne[1], HIGH);
    letzteZeit = jetztigeZeit;
  }
}

void rechts() {
  unsigned long jetztigeZeit = millis();
  if(jetztigeZeit - letzteZeit >= intervall) {
    digitalWrite(motorenHinten[1], LOW);
    digitalWrite(motorenVorne[1], LOW);
    digitalWrite(motorenHinten[0], HIGH);
    digitalWrite(motorenVorne[0], HIGH);
    letzteZeit = jetztigeZeit;
  }
}

int berechneDistanz(byte sensor) {
  static uint32_t nextOK[5] = {0, 0, 0, 0, 0};

  if(millis() < nextOK[sensor]) {
    return -2;
  }

  digitalWrite(trigPins[sensor], HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPins[sensor], LOW);

  long dauer = pulseIn(echoPins[sensor], HIGH, 5000);
  nextOK[sensor] = millis() + 60;
  if(dauer == 0) {
    return -1;
  }
  return (dauer * 0.330 / 2);
}

class MyCallbacks: public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic *pCharacteristic) {
    std::string value = pCharacteristic->getValue();

    if (value.length() > 0) {
      String data = String(value.c_str());
      int komma = data.indexOf(',');
      char c = value[0];
      if(c == 'U') {
        vorne();
      } else if(c == 'D') {
        hinten();
      } else if(c == 'L') {
        links();
      } else if(c == 'R') {
        rechts();
      } else if(c == 'C') {
        neutral();
      } else if(c == 'A') {
        stopp();
        neutral();
      }
    }
  }
};

void setup() {
  Serial.begin(115200);
  Serial.println("KOREX-KI-Roboter v1.0");

  for(int i = 0; i < 4; i++) {
    pinMode(motorenVorne[i], OUTPUT);
    pinMode(motorenHinten[i], OUTPUT);
  }
  for(byte i = 0; i < sensorCount; i++) {
    pinMode(trigPins[i], OUTPUT);
    digitalWrite(trigPins[i], LOW);
    pinMode(echoPins[i], INPUT);
  }
  pinMode(ledPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);

  servo.attach(35);
  servo.write(75);

  BLEDevice::init("Korex KI-Roboter");
  BLEServer *pServer = BLEDevice::createServer();
  BLEService *pService = pServer->createService(SERVICE_UUID);

  pCharacteristic = 
  pService->createCharacteristic(
    CHARACTERISTIC_UUID,
    BLECharacteristic::PROPERTY_WRITE
  );
  pCharacteristic->setCallbacks(new MyCallbacks());
  pService->start();
  pServer->getAdvertising()->start();
}

void loop(){
  uint32_t jetzt = millis();

  if(buzzerDelay > 0) {
    static uint32_t vorherigeZeit = 0;

    if (jetzt - vorherigeZeit >= buzzerDelay) 
    {
      tone(buzzerPin, 1500, 20);
      vorherigeZeit = jetzt;
    }
  }
  int minDistanz = 10000;
  for(byte i = 0; i < sensorCount; i++) {
    int distanz = berechneDistanz(i);

    if(distanz == -2) {
      continue;
    }
    if(distanz >= 0 && distanz < minDistanz) {
      minDistanz = distanz;
    }
  }

  const int nahe = 100, extremNahe = 25;
  const int schnell = 25, langsam = 600;

  static bool warNahe = false;
  bool istNahe = (minDistanz >= 0 && minDistanz < nahe);
  int hell;
  if(istNahe) {
    Serial.println(minDistanz);
    buzzerDelay = map(minDistanz, nahe, extremNahe, langsam, schnell);
    buzzerDelay = constrain(buzzerDelay, schnell, langsam);

    hell = map(minDistanz, nahe, extremNahe, 10, 255);
  } else {
    buzzerDelay = 0;
    hell = 0;
  }

  static bool ledZustand = false;
  static uint32_t letzteLedZeit = 0;

  if(buzzerDelay > 0) {
    if(jetzt - letzteLedZeit >= buzzerDelay) {
      ledZustand = !ledZustand;
      digitalWrite(ledPin, ledZustand);
      letzteLedZeit = jetzt;
    }
  } else {
    digitalWrite(ledPin, LOW);
    ledZustand = false;
  }

  warNahe = istNahe;
  if(Serial.available()) {
    char c = Serial.read();
    if(c == 'V') {
      vorne();
      Serial.println("Vorne");
    } 
    else if(c == 'H') {
      hinten();
      Serial.println("Hinten");
    }
    else if(c == 'S') {
      stopp();
      Serial.println("Stopp");
    }
  }
}
